{
  "name": "steam-native-notifications",
  "version": "0.1.0",
  "description": "Mirror Steam notification toasts to the desktop notification daemon.",
  "license": "MIT",
  "author": "Ty Smith",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "starlight watch",
    "build": "bun tools/gen-proto.mjs && bun tools/gen-build-identity.ts && tsc --noEmit && starlight pack",
    "gen": "bun tools/gen-proto.mjs",
    "proto:check": "bun tools/proto-sync.mjs --check",
    "proto:update": "bun tools/proto-sync.mjs --update",
    "gen:table": "bun tools/gen-types-table.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "starlight lsp",
    "test": "bun tools/test.ts",
    "build:standalone": "bun tools/gen-proto.mjs && bun tools/gen-build-identity.ts && bun standalone/build.ts && tsc --noEmit",
    "start:standalone": "bun standalone/daemon.ts",
    "test:standalone": "bun test standalone/*.test.ts && bun test ./standalone/client.contract-test.ts",
    "snn": "bun standalone/cli.ts",
    "build:release": "bun run build:standalone && bun tools/build-release.ts",
    "test:shared": "bun tools/test.ts shared",
    "test:linux": "bun tools/test.ts linux",
    "test:windows": "bun tools/test.ts windows"
  },
  "devDependencies": {
    "@steambrew/starlight": "^1.1.6",
    "@types/bun": "^1.4.2",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "typescript": "^5.7.2"
  }
}
