#!/usr/bin/env node
// Exercise the Millennium-free click, decode, and chooser subgraph.

import { existsSync, readFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import { loadFrontendModules } from './load-frontend.mjs';

const mods = loadFrontendModules(['notification', 'choose']);
const { notification, choose } = mods;

let failures = 0;
function check(what, ok, detail) {
	if (ok) {
		console.log(`  ok   ${what}`);
	} else {
		failures += 1;
		console.log(`  FAIL ${what}${detail ? `\n       ${detail}` : ''}`);
	}
}
function is(what, got, want) {
	check(what, Object.is(got, want), `got ${JSON.stringify(got)}, want ${JSON.stringify(want)}`);
}

// --- millennium-free boundary ----------------------------------------------

// The core modules must never import 'millennium' directly: that boundary is
// what keeps them compilable here without Steam and portable to a
// non-Millennium host (docs/architecture.md). Indirect imports like './log'
// are fine; only a direct 'millennium' import breaks the boundary.
const root = join(dirname(fileURLToPath(import.meta.url)), '..');
for (const path of [
	'frontend/routes.ts',
	'frontend/urlstore.ts',
	'frontend/identity.ts',
	'frontend/overlay.ts',
	'frontend/generated/notifications.ts',
	'vendor/steammessages_clientnotificationtypes.proto',
]) {
	check(`${path} is present for durable fallback routing`, existsSync(join(root, path)));
}
for (const name of ['choose', 'fiber', 'notification', 'replay']) {
	const source = readFileSync(join(root, 'frontend', `${name}.ts`), 'utf8');
	check(`frontend/${name}.ts stays free of direct millennium imports`,
		!/from\s+['"]millennium['"]|require\(\s*['"]millennium['"]\s*\)/.test(source),
		`frontend/${name}.ts imports 'millennium'; the offline-test boundary forbids that`);
}

const replaySource = readFileSync(join(root, 'frontend', 'replay.ts'), 'utf8');
check('replay handlers have no time-based expiry', !replaySource.includes('CLICK_WINDOW_MS'));
check('replay handlers retain at most 256 delivered clicks', /STASH_MAX\s*=\s*256/.test(replaySource));
check('replay diagnostic metadata is bounded per click',
	/candidates:\s*candidates\.slice\(0,\s*LOG_CANDIDATES_MAX\)\.map\(toMeta\)/.test(replaySource));

// --- durable click envelope ------------------------------------------------

let click = null;
try {
	click = loadFrontendModules(['click']).click;
	check('durable click module loads', true);
} catch (error) {
	check('durable click module loads', false, String(error));
}

if (click) {
	const token = '00112233445566778899aabbccddeeff';
	const envelope = {
		v: 1,
		token,
		captureAppId: 0,
		fallback: 'steam://friends/message/76561198000000000',
		focus: 'chat',
	};
	const encoded = click.encodeClickEnvelope(envelope);
	is('click envelope round trips', JSON.stringify(click.decodeClickEnvelope(encoded)), JSON.stringify(envelope));
	is('click-file payload round trips', JSON.stringify(click.decodeClickPayload(`click:${encoded}`)), JSON.stringify(envelope));
	is('canonical notification URL round trips',
		JSON.stringify(click.clickEnvelopeFromSteamUrl(`steam://steam-native-notify/notification/${encoded}`)), JSON.stringify(envelope));
	is('canonical single-slash URL round trips',
		JSON.stringify(click.clickEnvelopeFromSteamUrl(`steam:/steam-native-notify/notification/${encoded}/`)), JSON.stringify(envelope));
	is('canonical URL formats once',
		click.steamNotificationUrl(encoded), `steam://steam-native-notify/notification/${encoded}`);
	is('legacy snn URL is refused',
		click.clickEnvelopeFromSteamUrl(`steam://snn/click/${encoded}`), null);

	is('desktop toast captures appid 0', click.captureAppIdFromToastName('notificationtoasts_10000_desktop'), 0);
	is('Millennium desktop toast captures appid 0',
		click.captureAppIdFromToastName('notificationtoasts_undefined_desktop'), 0);
	is('future desktop toast identities do not block replay',
		click.captureAppIdFromToastName('notificationtoasts_future-format_desktop'), 0);
	is('overlay toast captures its appid', click.captureAppIdFromToastName('notificationtoasts_uid570-10001'), 570);
	is('another real overlay toast form captures its appid',
		click.captureAppIdFromToastName('notificationtoasts_uid553850-10002'), 553850);
	is('future overlay toast identities do not block replay',
		click.captureAppIdFromToastName('notificationtoasts_uid570-future-format'), 570);
	for (const name of [
		'notificationtoasts_',
		'notificationtoasts_vr',
		'notificationtoasts_10000',
		'notificationtoasts_10000_desktop_extra',
		'notificationtoasts_10000_desktop\n',
		'notificationtoasts_uidbogus-10001',
		'notificationtoasts_uid570-',
		'notificationtoasts_uid570-42_desktop',
		'notificationtoasts_uid570-10001\n',
		'notificationtoasts_uid0-10001',
		'notificationtoasts_uid-570-10001',
		'notificationtoasts_uid4294967296-10001',
	]) {
		is(`unconfirmed toast surface is rejected: ${name}`, click.captureAppIdFromToastName(name), null);
	}
	is('unknown popup is rejected', click.captureAppIdFromToastName('SP Desktop'), null);
	is('same desktop surface matches', click.surfaceMatches(0, 0), true);
	is('desktop and overlay surfaces differ', click.surfaceMatches(0, 570), false);
	is('same overlay app matches', click.surfaceMatches(570, 570), true);
	is('different overlay apps differ', click.surfaceMatches(570, 730), false);
	is('matching live handler prefers replay', click.deliveryMode?.(envelope, 0, true), 'replay');
	is('surface change chooses the fallback', click.deliveryMode?.(envelope, 570, true), 'fallback');
	is('missing post-restart handler chooses the fallback', click.deliveryMode?.(envelope, 0, false), 'fallback');
	is('no handler and no fallback does nothing',
		click.deliveryMode?.({ ...envelope, fallback: null }, 0, false), 'none');
	is('a mismatched handler without fallback does nothing',
		click.deliveryMode?.({ ...envelope, fallback: null }, 570, true), 'none');

	is('friend messages focus chat', click.focusKindFor(8, envelope.fallback), 'chat');
	is('friend routes focus chat', click.focusKindFor(999, envelope.fallback), 'chat');
	is('group-chat actions focus chat', click.focusKindFor(9, 'action:chatroom:7:8'), 'chat');
	is('achievements focus the main window', click.focusKindFor(5, 'steam://openurl/https://steamcommunity.com/x'), 'main');

	const tokenA = click.newClickToken();
	const tokenB = click.newClickToken();
	check('random click token is 128-bit hex', /^[a-f0-9]{32}$/.test(tokenA), tokenA);
	check('random click tokens do not reuse popup identity', tokenA !== tokenB);

	for (const bad of [
		'',
		'not-base64',
		click.encodeClickEnvelope({ ...envelope, v: 2 }),
		click.encodeClickEnvelope({ ...envelope, token: 'notificationtoasts_10000_desktop' }),
		click.encodeClickEnvelope({ ...envelope, captureAppId: -1 }),
		click.encodeClickEnvelope({ ...envelope, fallback: 'file:///etc/passwd' }),
		click.encodeClickEnvelope({ ...envelope, focus: 'other' }),
	]) {
		is(`malformed click envelope is refused: ${JSON.stringify(bad).slice(0, 50)}`, click.decodeClickEnvelope(bad), null);
	}
	is('old toast-name replay URL is refused',
		click.clickEnvelopeFromSteamUrl('steam://snn/replay/notificationtoasts_10000_desktop'), null);
}

// --- notificationFromToast -------------------------------------------------

// The real input is a popup window whose React tree carries Steam's decoded
// notification; these fixtures fake just the surfaces it reads -- an element
// list with a __reactFiber key and a fiber chain -- with plain objects.
function fiberChain(props, depth) {
	let fiber = { memoizedProps: { notification: props } };
	for (let i = 0; i < depth; i++) fiber = { memoizedProps: {}, return: fiber };
	return fiber;
}
function toastWindow(fiber) {
	const el = fiber ? { __reactFiber$test: fiber } : {};
	return { document: { querySelectorAll: () => [el] } };
}

const clientArray = [570, 'x'];

const client = notification.notificationFromToast(
	toastWindow(fiberChain({ eType: 1, eSource: 1, data: { array: clientArray } }, 0)),
);
check('client toast decodes', client !== null && client.source === 'client', JSON.stringify(client));
if (client?.source === 'client') {
	is('client toast carries the type', client.type, 1);
	is('client toast decodes appid by field number', client.fields.appid, 570);
}

const srv = notification.notificationFromToast(
	toastWindow(fiberChain(
		{ eType: 27, eSource: 2, data: { type: 9, item: { body_data: '{"tradeofferid":"55"}' }, url: 'x/y' } }, 0,
	)),
);
check('server toast decodes', srv !== null && srv.source === 'server', JSON.stringify(srv));
if (srv?.source === 'server') {
	is('server toast carries the type', srv.type, 27);
	is('server toast carries the rollup type', srv.server.type, 9);
	is('server toast parses body_data', srv.server.body?.tradeofferid, '55');
	is('server toast carries the url', srv.server.url, 'x/y');
}

const badBody = notification.notificationFromToast(
	toastWindow(fiberChain({ eType: 27, eSource: 2, data: { type: 9, item: { body_data: 'not json' } } }, 0)),
);
check('unparseable body_data decodes with body null',
	badBody?.source === 'server' && badBody.server.body === null, JSON.stringify(badBody));

const deep = notification.notificationFromToast(
	toastWindow(fiberChain({ eType: 1, eSource: 1, data: { array: clientArray } }, 2)),
);
check('notification found up the fiber.return chain',
	deep?.source === 'client' && deep.fields.appid === 570, JSON.stringify(deep));

const millenniumUpdate = notification.notificationFromToast(
	toastWindow(fiberChain({
		eType: 12,
		eSource: 1,
		millennium: true,
		data: {
			title: 'Updates Available!',
			body: 'Millennium found 1 available update',
			onClick: function wrappedAction() {},
		},
	}, 0)),
);
check('Millennium update toast carries its durable route',
	millenniumUpdate?.source === 'millennium' &&
		millenniumUpdate.fallback === 'steam://millennium/settings/updates',
	JSON.stringify(millenniumUpdate));

const millenniumSelfUpdate = notification.notificationFromToast(
	toastWindow(fiberChain({
		eType: 12,
		eSource: 1,
		millennium: true,
		data: {
			title: 'Millennium Update Available',
			body: 'A new version of Millennium is available! Click here to update.',
			onClick: function wrappedAction() {},
		},
	}, 0)),
);
check('Millennium self-update toast carries its durable route',
	millenniumSelfUpdate?.source === 'millennium' &&
		millenniumSelfUpdate.fallback === 'steam://millennium/settings/updates',
	JSON.stringify(millenniumSelfUpdate));

const millenniumUnknown = notification.notificationFromToast(
	toastWindow(fiberChain({ eType: 12, eSource: 1, millennium: true, data: { onClick() {} } }, 0)),
);
check('unknown Millennium toast carries only the general Steam fallback',
	millenniumUnknown?.source === 'millennium' &&
		millenniumUnknown.fallback === 'steam://open/main',
	JSON.stringify(millenniumUnknown));

is('a window with no fiber yields null', notification.notificationFromToast(toastWindow(null)), null);

// --- chooseHandler ---------------------------------------------------------

// Which stashed handler a click may invoke. The fixtures mirror live dumps
// (docs/experiments/click-replay.md): Steam drills the same function object
// down the wrapper chain, so proof is identity, never position.
function cand(prop, depth, fn) {
	return { prop, depth, fn, fnName: '', snippet: '' };
}
const activate = () => {};
const wrapper = () => {}; // the drilled body click: activate + dismissal
const accept = () => {}; // an inner button: its own function, ACTS on invoke

// The SystemUpdate shape: one function drilled through every level.
const drilledSame = [cand('onActivate', 10, activate), cand('onActivate', 11, activate),
	cand('onActivate', 12, activate), cand('onClick', 14, activate)];
is('twin: fully drilled handler picks the DOM click',
	choose.chooseHandler(drilledSame)?.chosen.depth, 14);
is('twin: fully drilled handler reports twin', choose.chooseHandler(drilledSame)?.how, 'twin');

// The FriendMessage shape: bare activate above, wrapper drilled to the DOM.
const drilledWrapper = [cand('onActivate', 10, activate), cand('onActivate', 11, wrapper),
	cand('onClick', 13, wrapper)];
is('twin: wrapper chain picks the DOM click, not the bare activate',
	choose.chooseHandler(drilledWrapper)?.chosen.depth, 13);

// A voice-chat-like shape: an inner button deeper than the body click must
// never win -- its function twins no onActivate.
const withButton = [...drilledWrapper, cand('onClick', 15, accept)];
is('twin: an inner button deeper than the body click never wins',
	choose.chooseHandler(withButton)?.chosen.fn, wrapper);

// Sole: one distinct function with no onActivate twin is unambiguous.
is('sole: a single onClick with no activate is chosen',
	choose.chooseHandler([cand('onClick', 5, activate)])?.how, 'sole');
is('sole: one function at several depths picks the deepest',
	choose.chooseHandler([cand('onClick', 5, activate), cand('onClick', 8, activate)])?.chosen.depth, 8);

// Refusals: ambiguity without proof stays unclickable.
is('refuse: distinct handlers with no twin choose nothing',
	choose.chooseHandler([cand('onActivate', 10, activate), cand('onClick', 12, accept)]), null);
is('refuse: an onActivate deeper than the onClick is no twin',
	choose.chooseHandler([cand('onClick', 10, wrapper), cand('onActivate', 12, wrapper), cand('onClick', 13, accept)]), null);
is('refuse: an empty candidate list chooses nothing', choose.chooseHandler([]), null);

console.log(failures === 0 ? '\nPASS' : `\n${failures} FAILED`);
process.exit(failures === 0 ? 0 : 1);
