#!/bin/sh
# Deliver one Steam notification to the desktop, and act on a click.
#
# Spawned detached by backend/main.lua, one per notification. It exists as its
# own process because `notify-send --action` implies `--wait`: it blocks until
# the notification is dismissed or clicked, which would otherwise tie up the
# plugin backend for the notification's lifetime and serialise every
# notification behind the last one.
#
# Usage: notify-action <title> <body> [image] [click-route] [ingame-action]
#        notify-action --resolve-icon <url>              print the resolved icon path
#        notify-action --notification-url <click-route>  print the durable activation URL
#        notify-action --escape-markup <text>            print the escaped form
#        notify-action --daemon-caps                     body-markup | plain
#
# <body> arrives raw; markup escaping happens here, immediately before the
# notify-send that renders it. <ingame-action> is a token for types whose
# desktop route is null but whose in-game click does something (see
# frontend/routes.ts clientOverlayAction). The five positional arguments are a
# contract shared with backend/main.lua (which builds the invocation) and
# tools/test-backend (which asserts it). Everything else the backend knows
# arrives through files in the runtime directory (steam-dir, below), never
# as a sixth argument.
#
# Linux only, today: notify-send and gdbus are FreeDesktop tools. The paths
# below already know the Flatpak and macOS layouts; the delivery half for
# those platforms is planned in docs/platforms.md, and an unsupported
# platform is refused in the log, never silently.

set -u

# Steam's loader environment is poison to system child binaries: its runtime
# LD_LIBRARY_PATH pins an old libcurl.so.4 the system curl refuses
# (CURL_OPENSSL_4 not found, verified 2026-08-30), and only path ordering
# spares notify-send and gdbus. Scrubbed once here so every child is immune.
unset LD_LIBRARY_PATH LD_PRELOAD

APP_NAME="Steam"
# The icon-theme name used whenever no real artwork can be resolved.
FALLBACK_ICON="steam"
RUNTIME_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/steam-native-notify"
# Since the image-path hint (30982bf) the daemon receives a PATH into this
# cache, not pixels: a file removed here can blank a history row on a daemon
# that does not copy what it shows (quickshell copies its own; others
# unverified). The 30-day prune leans on history only showing recent rows.
CACHE="$RUNTIME_DIR/icons"

# Steam's data directory, for the library cache the toast artwork maps onto.
# The backend publishes millennium.steam_path() to RUNTIME_DIR/steam-dir at
# load and that answer leads; the guesses cover a missing file and an answer
# without a library cache (Millennium's macOS answer is the app bundle).
# Native Linux first, then Steam's Flatpak per-app directory as the host
# sees it, then the macOS data directory. The first with a library cache
# wins; none means every game icon falls back to the theme.
steam_dir_candidates() {
	published=""
	if [ -r "$RUNTIME_DIR/steam-dir" ]; then
		IFS= read -r published <"$RUNTIME_DIR/steam-dir" || :
		[ -n "$published" ] && printf '%s\n' "$published"
	fi
	printf '%s\n' \
		"$HOME/.steam/steam" \
		"$HOME/.local/share/Steam" \
		"$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam" \
		"$HOME/.var/app/com.valvesoftware.Steam/.steam/steam" \
		"$HOME/Library/Application Support/Steam"
}
steam_dir() {
	steam_dir_candidates | while IFS= read -r candidate; do
		if [ -d "$candidate/appcache/librarycache" ]; then
			printf '%s\n' "$candidate"
			break
		fi
	done
}
STEAM_DIR=$(steam_dir)
LIBRARY_CACHE="${STEAM_DIR:+$STEAM_DIR/appcache/librarycache}"

# steam.desktop: GNOME and KDE brand the notification from it (app name, logo
# badge, per-app grouping and settings); quickshell resolves it into the app
# icon slot. Daemons that do not read it ignore it. Flatpak Steam exports its
# desktop file as com.valvesoftware.Steam.desktop (the manifest renames it),
# so that is the name whenever Steam is the sandboxed one: this runs inside
# the sandbox (FLATPAK_ID), or on the host with the per-app directory found.
DESKTOP_ENTRY="steam"
if [ "${FLATPAK_ID:-}" = "com.valvesoftware.Steam" ]; then
	DESKTOP_ENTRY="com.valvesoftware.Steam"
else
	case $STEAM_DIR in
	*/.var/app/com.valvesoftware.Steam/*) DESKTOP_ENTRY="com.valvesoftware.Steam" ;;
	esac
fi

# The Desktop Notifications spec reserves "default" for the action a plain body
# click invokes. Any other name only fires from a button the daemon may or may
# not draw.
ACTION="default"

title=${1:-Steam}
body=${2:-}
image=${3:-}
route=${4:-}

notification_url() {
	payload=${1#click:}
	[ "$payload" != "$1" ] || return 1
	case $payload in '' | *[!A-Za-z0-9_-]*) return 1 ;; esac
	[ "${#payload}" -le 8192 ] || return 1
	printf 'steam://steam-native-notify/notification/%s\n' "$payload"
}

# A daemon that advertises `body-markup` parses the body as markup, and a
# bare `<` or `&` from a chat message would be swallowed or mangled. Only the
# body is parsed per the spec; the summary is passed through untouched.
escape_markup() {
	printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# Whether to escape is the daemon's call, advertised via GetCapabilities:
# quickshell, GNOME, KDE and mako parse markup; dunst is configurable either
# way. Escaping for a plain-text daemon shows literal entities, so ask. If the
# daemon is unreachable (login race; the send below retries), assume markup --
# right for the daemons that dominate, merely cosmetic when wrong.
daemon_parses_markup() {
	caps=$(gdbus call --session --dest org.freedesktop.Notifications \
		--object-path /org/freedesktop/Notifications \
		--method org.freedesktop.Notifications.GetCapabilities 2>/dev/null) || return 0
	case $caps in
	*body-markup*) return 0 ;;
	*) return 1 ;;
	esac
}

daemon_is_quickshell() {
	server_info=$(gdbus call --session --dest org.freedesktop.Notifications \
		--object-path /org/freedesktop/Notifications \
		--method org.freedesktop.Notifications.GetServerInformation 2>/dev/null) || return 1
	case $server_info in
	'ssss "quickshell" '* | "('quickshell',"*) return 0 ;;
	*) return 1 ;;
	esac
}

# Turn whatever the toast was showing into something notify-send can display.
# Game art needs no fetch: Steam serves it from a virtual host whose paths map
# one-to-one onto the on-disk library cache. A friend's avatar is on the public
# CDN and has to be pulled once, then cached. Prints either an absolute path
# or the literal theme name $FALLBACK_ICON -- the caller dispatches on that.
resolve_icon() {
	raw=$1
	[ -n "$raw" ] || { echo "$FALLBACK_ICON"; return; }

	case $raw in
	/*)
		[ -f "$raw" ] && echo "$raw" || echo "$FALLBACK_ICON"
		return
		;;
	*steamloopback.host/assets/*)
		tail=${raw#*steamloopback.host/assets/}
		tail=${tail%%\?*}
		if [ -n "$LIBRARY_CACHE" ] && [ -f "$LIBRARY_CACHE/$tail" ]; then
			echo "$LIBRARY_CACHE/$tail"
		else
			echo "$FALLBACK_ICON"
		fi
		return
		;;
	http://* | https://*) ;;
	*)
		echo "$FALLBACK_ICON"
		return
		;;
	esac

	# Prune cached avatars untouched for 30 days, before the lookup below so it
	# can never remove this run's icon between resolve and notify-send. Losing
	# one is safe: the daemon persists its own copy of every icon it shows, and
	# a pruned icon is simply re-downloaded on next use. Best-effort only --
	# housekeeping must never block delivery.
	[ -d "$CACHE" ] && find "$CACHE" -type f -mtime +30 -exec rm -f {} + >/dev/null 2>&1

	stem=${raw%%\?*}
	ext=${stem##*.}
	case $ext in
	jpg | jpeg | png | gif | webp) ext=".$ext" ;;
	*) ext=".img" ;;
	esac

	key=$(printf '%s' "$stem" | sha1sum | cut -d' ' -f1)
	cached="$CACHE/$key$ext"

	if [ -s "$cached" ]; then
		echo "$cached"
		return
	fi

	mkdir -p "$CACHE" 2>/dev/null || { echo "$FALLBACK_ICON"; return; }
	# Download to a temp name and rename, so an interrupted fetch cannot leave a
	# truncated icon cached forever. (The loader-env scrub curl depends on
	# happens once at the top of the script.)
	if curl -fsSL --max-time 5 -o "$cached.part" "$raw" 2>/dev/null && [ -s "$cached.part" ]; then
		mv -f "$cached.part" "$cached"
		echo "$cached"
	else
		rm -f "$cached.part" 2>/dev/null
		echo "$FALLBACK_ICON"
	fi
}

# Resolution is the fiddliest part and the easiest to get wrong silently, so it
# is exposed for testing: notify-action --resolve-icon <url>
if [ "${1:-}" = "--resolve-icon" ]; then
	resolve_icon "${2:-}"
	exit 0
fi

if [ "${1:-}" = "--notification-url" ]; then
	notification_url "${2:-}"
	exit $?
fi

# Escaping is easy to get wrong silently, so it is exposed for testing like
# the other seams: notify-action --escape-markup <text>
if [ "${1:-}" = "--escape-markup" ]; then
	escape_markup "${2:-}"
	exit 0
fi

if [ "${1:-}" = "--daemon-caps" ]; then
	daemon_parses_markup && echo body-markup || echo plain
	exit 0
fi

# Delivery needs notify-send and the FreeDesktop daemon behind it. macOS has
# neither (its delivery is a plan, docs/platforms.md), and a Linux box can
# lack libnotify. Either is said in the backend's session log, where
# tools/capture looks, before this exits: a dropped notification is never
# silent. After the seams above, which are portable and need no daemon.
refuse() {
	printf '%s [steam-native-notify] notify-action: %s\n' \
		"$(date '+[%Y-%m-%d %H:%M:%S]')" "$1" >>"$RUNTIME_DIR/plugin.log" 2>/dev/null
	exit 1
}
case $(uname -s 2>/dev/null) in
Darwin) refuse "unsupported platform: macos delivery is not implemented (docs/platforms.md), notification dropped" ;;
esac
command -v notify-send >/dev/null 2>&1 \
	|| refuse "notify-send not found on PATH (install libnotify), notification dropped"

icon=$(resolve_icon "$image")
if daemon_parses_markup; then
	body=$(escape_markup "$body")
fi
activation_url=""
if converted=$(notification_url "$route"); then
	activation_url=$converted
fi

# A file-backed icon rides the image-path hint as a file:// reference, with -i
# left as the themed fallback. Through -i, notify-send sends a path as
# image-data pixels, which the daemon keeps only in-process: the live popup
# renders them, but a history row has nothing left to show (verified against
# quickshell's persisted state, 2026-08-30). A file reference the daemon can
# copy survives -- and image-data beats image-path, so the path must not ALSO
# ride -i.
#
# file://$icon is raw concatenation: a path holding # ? or % would mis-parse
# in GLib/Qt URI parsers, but dunst strips file:// without percent-decoding,
# so no encoding satisfies every daemon. Cache names are sha1 hashes; only a
# hostile $XDG_CACHE_HOME or $HOME could smuggle those characters in.
#
# Rebuild argv for every attempt. The daemon can appear between retries, and a
# recovered Quickshell must receive its durable activation hint on that send.
send_notification() {
	# set -- because POSIX sh has no arrays and a quoted string would
	# word-split on a path with spaces.
	case $icon in
	/*) set -- -i "$FALLBACK_ICON" -h "string:image-path:file://$icon" ;;
	*) set -- -i "$icon" ;;
	esac

	if [ -n "$activation_url" ] && daemon_is_quickshell; then
		set -- "$@" -h "string:omarchy-exec-argv:[\"steam\",\"$activation_url\"]"
	fi
	if [ -n "$activation_url" ]; then
		set -- "$@" -A "$ACTION=Open"
	fi

	notify-send -a "$APP_NAME" -h "string:desktop-entry:$DESKTOP_ENTRY" "$@" \
		"$title" "$body" 2>/dev/null
}

# Blocks here. On a click the action name is printed; on dismissal, nothing is.
#
# The daemon can be briefly absent -- at login the backend can deliver before
# the session's daemon owns the bus name (observed: a fire 24s after login was
# lost), and a daemon restart drops it too. notify-send fails fast and
# silently then, so retry for ~30s rather than lose the notification; a
# machine with no daemon at all gives up quietly.
tries=0
until chosen=$(send_notification); do
	# Retry ONLY while the daemon is absent. A failure with the daemon
	# reachable is something else (it may even have fired after the toast
	# displayed), and retrying would re-deliver the same notification.
	if gdbus call --session --dest org.freedesktop.Notifications \
		--object-path /org/freedesktop/Notifications \
		--method org.freedesktop.Notifications.GetCapabilities >/dev/null 2>&1; then
		exit 1
	fi
	tries=$((tries + 1))
	[ "$tries" -lt 10 ] || exit 1
	sleep "${NOTIFY_ACTION_RETRY_DELAY:-3}"
done

[ "$chosen" = "$ACTION" ] || exit 0
[ -n "$activation_url" ] || exit 0
command -v steam >/dev/null 2>&1 \
	|| refuse "steam not found on PATH, activation refused"
steam "$activation_url" >/dev/null 2>&1 &
exit 0
