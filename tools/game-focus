#!/usr/bin/env python3
"""Read-only host focus correction for a uniquely identified nested Gamescope."""
import os
import socket
import struct
import sys
import time
from pathlib import Path


def select(appid, windows, owners):
    wrappers = [active for name, active in windows if name == 'gamescope']
    if owners != [appid] or len(wrappers) != 1 or sum(active for _, active in windows) != 1:
        return 'unknown'
    return 'game' if wrappers[0] else 'desktop'


def gamescope_owners():
    owners = []
    for process in Path('/proc').iterdir():
        if not process.name.isdecimal():
            continue
        try:
            if process.joinpath('exe').resolve().name != 'gamescope':
                continue
            env = process.joinpath('environ').read_bytes().split(b'\0')
            value = next((v.split(b'=', 1)[1] for v in env if v.startswith(b'SteamAppId=')), b'')
            owners.append(int(value) if value.isdigit() else None)
        except (OSError, ValueError):
            # Unidentifiable wrappers must not make a multi-game setup look unique.
            if process.joinpath('comm').exists():
                try:
                    if process.joinpath('comm').read_text().strip().startswith('gamescope'):
                        owners.append(None)
                except OSError:
                    pass
    return owners


def windows():
    """Snapshot wlr foreign-toplevel v1 using only registry/bind/sync requests.

    No activation requests or seat access. A bounded roundtrip follows binding
    so initial toplevel details have arrived before the snapshot is used.
    """
    display = os.environ.get('WAYLAND_DISPLAY')
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    if not display or not runtime:
        return []
    address = display if os.path.isabs(display) else os.path.join(runtime, display)
    deadline = time.monotonic() + 0.5
    uint = lambda n: struct.pack('=I', n)
    def string(s):
        raw = s.encode() + b'\0'
        return uint(len(raw)) + raw + b'\0' * (-len(raw) % 4)
    def read_string(data, offset=0):
        size = struct.unpack_from('=I', data, offset)[0]
        if size < 1 or offset + 4 + size > len(data):
            raise ValueError('invalid string')
        return data[offset + 4:offset + 3 + size].decode(), offset + 4 + ((size + 3) & ~3)
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(0.5)
        sock.connect(address)
        def send(obj, opcode, payload):
            sock.sendall(struct.pack('=II', obj, ((8 + len(payload)) << 16) | opcode) + payload)
        buffer = bytearray()
        objects = {}
        manager = None
        def roundtrip(callback):
            nonlocal manager
            send(1, 0, uint(callback))
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError()
                sock.settimeout(remaining)
                while len(buffer) < 8:
                    chunk = sock.recv(65536)
                    if not chunk:
                        raise EOFError()
                    buffer.extend(chunk)
                obj, header = struct.unpack_from('=II', buffer)
                size, opcode = header >> 16, header & 65535
                if size < 8 or size % 4:
                    raise ValueError('invalid message')
                if len(buffer) < size:
                    chunk = sock.recv(65536)
                    if not chunk:
                        raise EOFError()
                    buffer.extend(chunk)
                    continue
                data = bytes(buffer[8:size])
                del buffer[:size]
                if obj == callback and opcode == 0:
                    return
                if obj == 1 and opcode == 0:
                    raise ValueError('Wayland error')
                if obj == 2 and opcode == 0:
                    name = struct.unpack_from('=I', data)[0]
                    interface, offset = read_string(data, 4)
                    if interface == 'zwlr_foreign_toplevel_manager_v1':
                        manager = name
                elif obj == 4 and opcode == 0:
                    handle = struct.unpack_from('=I', data)[0]
                    objects[handle] = ['', False]
                elif obj in objects:
                    if opcode == 1:
                        objects[obj][0] = read_string(data)[0]
                    elif opcode == 4:
                        length = struct.unpack_from('=I', data)[0]
                        if length % 4 or length + 4 != len(data):
                            raise ValueError('invalid states')
                        objects[obj][1] = 2 in struct.unpack('=' + 'I' * (length // 4), data[4:])
                    elif opcode == 6:
                        del objects[obj]
        send(1, 1, uint(2))
        roundtrip(3)
        if manager is None:
            return []
        send(2, 0, uint(manager) + string('zwlr_foreign_toplevel_manager_v1') + uint(1) + uint(4))
        roundtrip(5)
        return list(objects.values())


if __name__ == '__main__':
    try:
        appid = int(sys.argv[1])
        owners = gamescope_owners()
        print(select(appid, windows(), owners) if owners == [appid] else 'unknown')
    except (OSError, ValueError, IndexError, EOFError, struct.error):
        print('unknown')
