# Reference only; prefer bun standalone/setup.ts install for absolute paths,
# ownership, XDG roots, desktop autostart and current session environment import.
[Unit]
Description=Experimental Steam RT3 native notifications
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/steam-native-notifications
ExecStart=/absolute/path/to/bun /absolute/path/to/steam-native-notifications/standalone/daemon.ts --steam-dir /absolute/native/Steam
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=graphical-session.target
